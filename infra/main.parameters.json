{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=eastus2}"
    },
    "bootcampAccessToken": {
      "value": "${BOOTCAMP_ACCESS_TOKEN}"
    },
    "learnerPrincipalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "learnerPrincipalType": {
      "value": "${AZURE_PRINCIPAL_TYPE=User}"
    },
    "appExists": {
      "value": "${SERVICE_APP_RESOURCE_EXISTS=false}"
    },
    "searchSku": {
      "value": "${AZURE_AI_SEARCH_SKU=free}"
    },
    "searchIndexName": {
      "value": "${AZURE_AI_SEARCH_INDEX=support-knowledge}"
    },
    "chatDeploymentName": {
      "value": "${AZURE_AI_CHAT_DEPLOYMENT_NAME=gpt-4.1-mini}"
    },
    "chatModelName": {
      "value": "${AZURE_AI_CHAT_MODEL_NAME=gpt-4.1-mini}"
    },
    "chatModelVersion": {
      "value": "${AZURE_AI_CHAT_MODEL_VERSION=2025-04-14}"
    },
    "chatDeploymentSku": {
      "value": "${AZURE_AI_CHAT_DEPLOYMENT_SKU=GlobalStandard}"
    },
    "chatDeploymentCapacity": {
      "value": "${AZURE_AI_CHAT_DEPLOYMENT_CAPACITY=10}"
    },
    "embeddingDeploymentName": {
      "value": "${AZURE_AI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small}"
    },
    "embeddingModelName": {
      "value": "${AZURE_AI_EMBEDDING_MODEL_NAME=text-embedding-3-small}"
    },
    "embeddingModelVersion": {
      "value": "${AZURE_AI_EMBEDDING_MODEL_VERSION=1}"
    },
    "embeddingDeploymentSku": {
      "value": "${AZURE_AI_EMBEDDING_DEPLOYMENT_SKU=Standard}"
    },
    "embeddingDeploymentCapacity": {
      "value": "${AZURE_AI_EMBEDDING_DEPLOYMENT_CAPACITY=10}"
    }
  }
}
