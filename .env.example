APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
PORT=8000

# Use mock mode to complete the local path without Azure resources.
USE_MOCK_SERVICES=true

# Set these after `azd provision` or when using existing Azure resources.
# FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
# FOUNDRY_MODEL=YOUR-CHAT-DEPLOYMENT
# EMBEDDING_MODEL=YOUR-EMBEDDING-DEPLOYMENT
# AZURE_AI_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
AZURE_AI_SEARCH_INDEX=support-knowledge
AZURE_AI_SEARCH_SEMANTIC_CONFIGURATION=support-semantic-config
AZURE_AI_SEARCH_VECTOR_FIELD=content_vector
EMBEDDING_DIMENSIONS=1536
# AZURE_CLIENT_ID=YOUR-MANAGED-IDENTITY-CLIENT-ID
# APPLICATIONINSIGHTS_CONNECTION_STRING=YOUR-CONNECTION-STRING
AZURE_EXPERIMENTAL_ENABLE_GENAI_TRACING=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# Generate a unique value. Never commit a real token.
BOOTCAMP_ACCESS_TOKEN=local-development-token
MAX_SESSION_TURNS=10
